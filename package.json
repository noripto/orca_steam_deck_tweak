{
  "name": "orca-streamdeck",
  "version": "1.0.0",
  "private": true,
  "description": "Control and monitor Orca AI coding agents from an Elgato Stream Deck.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/render-icons.mjs",
    "marketplace": "node scripts/render-marketplace.mjs",
    "build": "vp pack",
    "watch": "vp pack --watch",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate norigram.orca-ade.streamdeck.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@elgato/utils": "0.6.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.16.0",
    "typescript": "^5.6.3",
    "ultracite": "^7.10.7",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.13.1"
}
